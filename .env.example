MANA_VERSION=dev
COMPOSE_PROJECT_NAME=mana-dev

# Host ports. Internal service-to-service URLs use Docker service names.
MANA_UI_PORT=3000
MANA_HUB_PORT=8080
MANA_BRIDGE_PORT=8090
MANA_COX_PORT=8091
MANA_HIVE_PORT=18081
POSTGRES_PORT=5432
MONGO_PORT=27017
NATS_PORT=4222

# Development-only defaults. Production must override these values.
POSTGRES_DB=mana_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional image namespace for release builds.
MANA_IMAGE_PREFIX=mana
